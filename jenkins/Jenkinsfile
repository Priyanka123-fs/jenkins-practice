pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'echo Build from Jenkinsfile'
                sh '''
                docker ps
                docker --version
                pwd
                ls -la
                cd jenkins
                ls -la
                docker build -t mysite .
                docker run -p 80:80 mysite
                '''
            }
        }
    }
}
